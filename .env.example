# Copie para `.env` e preencha os segredos. Os defaults de DB/Redis batem com o docker-compose.yml.

NODE_ENV=development
PORT=3333
FRONTEND_URL=http://localhost:3000
# Base pública do backend — usada para montar a URL do avatar re-hospedado.
API_PUBLIC_URL=http://localhost:3333

# ─── Banco de dados (Docker: docker-compose.yml) ───
DATABASE_URL="postgresql://deepalpha:deepalpha@localhost:5433/deepalpha?schema=public"
# Opcionais de pool / read-replica:
# DATABASE_CONNECTION_LIMIT=10
# DATABASE_POOL_TIMEOUT=10
# DATABASE_READ_REPLICA_URL=

# ─── Redis (Docker) ───
# Redis é SEMPRE usado (sem flag de habilitação). Se estiver inacessível, a app
# degrada para cache/limitador em memória (fail-open). Host default = 127.0.0.1.
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=0

# ─── Auth / JWT ───
JWT_SECRET=troque-por-um-segredo-forte-em-producao
JWT_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN=7d
# JWT_REFRESH_SECRET=  (opcional; se vazio, é derivado de JWT_SECRET)
SESSION_SECRET=troque-por-um-segredo-forte-em-producao
# COOKIE_DOMAIN=            (vazio em dev local)

# ─── Google OAuth (login social) ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3333/api/v1/auth/google/callback

# ─── E-mail (SendGrid) / marca ───
# Sem SEND_GRID, os e-mails viram no-op logado (dev).
SEND_GRID=
SMTP_FROM=Deep Alpha <no-reply@deepalpha.app>
BRAND_NAME=Deep Alpha
BRAND_DOMAIN=deepalpha.app
PRIVACY_EMAIL=privacy@deepalpha.app
# COOKIE_DOMAIN=.deepalpha.app   (prod cross-subdomínio; vazio em dev = host-only)

# ─── Cloudflare Turnstile (anti-bot) ───
# Vazio em dev = guard fail-open (não bloqueia). Obrigatório em produção.
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# ─── Moralis (swaps EVM + OHLC/preço de token) ───
MORALIS_API_KEY=
# Opcionais (defaults embutidos):
# MORALIS_EVM_BASE=https://deep-index.moralis.io/api/v2.2
# MORALIS_SOLANA_BASE=https://solana-gateway.moralis.io
# MORALIS_SOLANA_NETWORK=mainnet

# ─── Helius (swaps Solana — cobre Axiom/Meteora/pump.fun, que a Moralis não indexa) ───
HELIUS_API_KEY=
# HELIUS_BASE=https://api.helius.xyz

# ─── Geolocalização (opcional, notificações de login) ───
# IPINFO_TOKEN=

# RPC Solana p/ taxa on-chain (meta.fee). Público = rate-limited/não-arquival; em prod use Helius/QuickNode.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
