{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "src/prisma/generated/**/*",
        "outDir": "dist"
      },
      {
        "include": "prisma/**/*",
        "outDir": "dist"
      },
      {
        "include": "common/templates/**/*",
        "outDir": "dist"
      },
      {
        "include": "common/templates/**/*",
        "outDir": "dist/src"
      },
      {
        "include": "common/assets/**/*",
        "outDir": "dist"
      },
      {
        "include": "common/assets/**/*",
        "outDir": "dist/src"
      }
    ]
  }
}