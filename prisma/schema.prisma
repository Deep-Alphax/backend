// Deep Alpha — Wallet Analytics / Trading PnL
// Prisma schema. Datasource PostgreSQL.
// Regras: valores monetários em Decimal (numeric) — NUNCA Float (perda de precisão).
// Timestamps sempre em UTC; o bucket por hora/dia aplica o timezone do usuário na leitura.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth / Identidade
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

model User {
  id       String @id @default(cuid())
  email    String @unique
  // Null quando a conta é só Google (sem login local por senha).
  password String?

  firstName String @default("")
  lastName  String @default("")
  // avatarUrl: URL exibida no front. Para contas Google, a foto é BAIXADA e
  // re-hospedada por nós (bytes em `avatarData`, servidos por GET /users/:id/avatar)
  // → avatarUrl aponta para o nosso endpoint, não para o googleusercontent.
  avatarUrl  String?
  avatarData Bytes? // imagem redimensionada (webp) — servida pelo nosso backend
  avatarMime String? // content-type de `avatarData` (ex.: image/webp)

  // Google OAuth (vínculo por googleId; e-mail verificado exigido na strategy).
  googleId    String? @unique
  googleEmail String?

  role          Role    @default(USER)
  isActive      Boolean @default(true)
  emailVerified Boolean @default(false)

  // 2FA por e-mail (opcional). Quando true, o login emite um challenge (mfaToken)
  // e só devolve tokens reais após o código OTP enviado por e-mail.
  mfaEnabled Boolean @default(false)

  // Revogação de sessão sem denylist: JwtStrategy rejeita access token com iat
  // anterior a passwordChangedAt (troca/reset de senha derruba sessões roubadas).
  passwordChangedAt DateTime?
  lastLoginAt       DateTime?

  language              String  @default("EN")
  acceptedTerms         Boolean @default(false)
  acceptedPrivacyPolicy Boolean @default(false)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  wallets         Wallet[]
  snapshots       MetricSnapshot[]
  sources         Source[]
  catalog         WalletCatalog[]
  favoriteAuthors FavoriteAuthor[]

  @@index([googleId])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Carteiras (multi-wallet, multi-chain)
// ─────────────────────────────────────────────────────────────────────────────

// Família da chain — governa validação de endereço e qual provider/normalizador usar.
enum ChainType {
  EVM
  SOLANA
}

// Chains concretas suportadas no MVP. EVM compartilha formato de endereço (0x…);
// SOLANA usa base58. Novas chains entram aqui sem alterar o resto do schema.
enum Chain {
  SOLANA
  ETHEREUM
  BASE
  ARBITRUM
  BSC
  POLYGON
  OPTIMISM
}

enum SyncStatus {
  PENDING // cadastrada, ainda não sincronizada
  SYNCING // ingestão em andamento
  SYNCED // histórico atualizado
  ERROR // última sync falhou (ver syncError)
}

// Fonte de swaps "pinada" por carteira: decidida no 1º sync e NUNCA trocada — os
// trades de uma carteira vêm sempre da MESMA fonte, evitando mistura (a mesma tx
// reconstruída por dois providers viraria linhas duplicadas/inconsistentes).
//  - BIRDEYE: Solana (trades dedicados, USD real) — primário quando há key.
//  - HELIUS:  Solana (reconstrução por delta) — fallback se o Birdeye falhar no 1º sync.
//  - MORALIS: EVM (Wallet API).
enum SwapSource {
  BIRDEYE
  HELIUS
  MORALIS
}

// Papel da carteira no sistema:
//  - OWN: carteira DO usuário (entra nas métricas de portfólio/PnL dele).
//  - SOURCE: carteira de uma FONTE de alpha que o usuário segue (ingerida para
//    atribuir os trades do usuário por lead-lag; NUNCA entra nas métricas dele).
// O mesmo pipeline de ingestão (WalletSyncService) serve os dois papéis.
enum WalletKind {
  OWN
  SOURCE
}

model Wallet {
  id String @id @default(cuid())

  // DEPRECATED (fase expand): a carteira agora é COMPARTILHADA (canônica por
  // chain+addressNorm) e a relação usuário↔carteira vive em WalletCatalog. Estes
  // campos seguem opcionais só durante a transição e serão dropados na fase contract.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // DEPRECATED (fase expand): papel agora vive em WalletCatalog.role. Ver acima.
  kind     WalletKind @default(OWN)
  sourceId String?
  source   Source?    @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  // address: forma canônica de exibição (checksum EVM / base58 Solana).
  // addressNorm: forma normalizada p/ dedupe e lookup (lowercase no EVM;
  // idêntico ao address no Solana, que é case-sensitive).
  address     String
  addressNorm String
  chainType   ChainType
  chain       Chain
  label       String?
  isActive    Boolean   @default(true)

  // Estado de sincronização com o provider.
  syncStatus   SyncStatus  @default(PENDING)
  syncSource   SwapSource? // fonte de swaps pinada (decidida no 1º sync, imutável)
  syncCursor   String? // cursor de paginação do provider (ingestão incremental)
  syncError    String?
  lastSyncedAt DateTime?
  firstTxAt    DateTime? // 1ª atividade on-chain conhecida (limite do histórico)

  // Auto-recuperação de falhas transitórias do provider (401/429/5xx/timeout):
  // tentativas consecutivas falhas + quando o cron pode retentar (backoff). Zeram no
  // sucesso. Falha permanente (400/404 de dado) ou teto de tentativas → nextRetryAt=null.
  syncAttempts Int       @default(0)
  nextRetryAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trades    Trade[]
  positions TokenPosition[]
  snapshots MetricSnapshot[]
  catalog   WalletCatalog[]

  // Carteira CANÔNICA/compartilhada: um único registro por (chain, addressNorm),
  // reusado por todos que a catalogam. O mesmo endereço 0x no Ethereum e no Base são
  // carteiras distintas (atividades on-chain independentes), então a unique é por
  // `chain`, não `chainType`.
  @@unique([chain, addressNorm])
  @@index([userId])
  @@index([syncStatus])
  // Cobre a varredura do cron por carteiras em ERROR prontas p/ retry (syncStatus+nextRetryAt).
  @@index([syncStatus, nextRetryAt])
  @@index([sourceId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Catálogo: liga um usuário a uma carteira (compartilhada) que ele acompanha.
// NÃO implica posse — é um bookmark/lookup. Os dados on-chain (trades) são únicos
// por carteira canônica e reusados por todos que a catalogam.
// ─────────────────────────────────────────────────────────────────────────────

// Papel da carteira NA PERSPECTIVA do usuário (substitui WalletKind, que vivia na
// Wallet e não permitia "OWN pra mim, SOURCE pra outro").
enum CatalogRole {
  TRACKED // carteira que o usuário acompanha (alimenta o dashboard dela)
  SOURCE // fonte de alpha (lead da atribuição lead-lag)
}

model WalletCatalog {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  role  CatalogRole @default(TRACKED)
  label String?

  // Fontes SOURCE podem pertencer a um grupo nomeado (Source). null p/ TRACKED.
  sourceId String?
  source   Source? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, walletId])
  @@index([userId])
  @@index([walletId])
  @@index([sourceId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Trades normalizados (fonte da verdade para todas as métricas)
// ─────────────────────────────────────────────────────────────────────────────

enum TradeSide {
  BUY // recebeu o token base, pagou em quote
  SELL // vendeu o token base, recebeu quote
}

// Um swap normalizado (uma perna base<->quote). Idempotente por (wallet, tx, mint, side).
model Trade {
  id       String @id @default(cuid())
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  chainType ChainType
  txHash    String
  blockTime DateTime // UTC — timestamp on-chain do bloco
  side      TradeSide

  // Ativo negociado (base) e ativo de cotação (quote — normalmente estável/native).
  baseMint   String
  baseSymbol String?
  baseAmount Decimal @db.Decimal(38, 18) // qtd absoluta do token base

  quoteMint   String
  quoteSymbol String?
  quoteAmount Decimal @db.Decimal(38, 18) // qtd absoluta do quote

  // Valuation em USD no instante do bloco (do provider). priceUsd = USD por 1 base.
  usdValue Decimal @db.Decimal(38, 12) // notional do trade em USD
  priceUsd Decimal @db.Decimal(38, 18)

  // Taxas: gas/DEX. feeUsd alimenta a métrica "% do valor que virou taxa".
  feeUsd    Decimal @default(0) @db.Decimal(38, 12)
  feeNative Decimal @default(0) @db.Decimal(38, 18)

  // Qualidade do dado: se o preço USD veio direto do provider (true) ou foi
  // estimado/imputado (false). Alimenta o campo de confiança/precisão dos agregados.
  priceResolved Boolean @default(true)

  dexProgram String? // router/programa da DEX
  raw        Json? // payload cru do provider (auditoria/reprocessamento)
  createdAt  DateTime @default(now())

  // Fontes de alpha às quais este trade foi atribuído (lead-lag). Só faz sentido
  // para trades de carteira OWN; recomputável (ver TradeAttribution).
  attributions TradeAttribution[]

  @@unique([walletId, txHash, baseMint, side])
  @@index([walletId, blockTime])
  @@index([walletId, baseMint, blockTime])
}

// ─────────────────────────────────────────────────────────────────────────────
// Fontes de alpha (desks/grupos que o usuário segue) + atribuição de trades
// ─────────────────────────────────────────────────────────────────────────────

// Uma "Fonte" = um provedor de sinal que o usuário acompanha, representado por
// uma ou mais carteiras on-chain (Wallet kind=SOURCE). Os trades do usuário são
// atribuídos a uma fonte quando ele COMPRA o mesmo token logo após a fonte.
model Source {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name     String
  isActive Boolean @default(true)

  // Janela de atribuição (lead-lag): tempo máximo, em horas, entre a compra da
  // fonte e a minha compra para o trade ainda contar como "segui essa fonte".
  attributionWindowHours Int @default(6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallets      Wallet[]
  attributions TradeAttribution[]
  entries      WalletCatalog[]

  // O nome é único por usuário (catálogo pessoal de fontes).
  @@unique([userId, name])
  @@index([userId])
}

// Atribuição de um trade (compra do usuário) a uma fonte, via lead-lag. Tabela
// derivada/recomputável: apagada e recriada quando trades/fontes mudam. Uma
// mesma compra pode casar com mais de uma fonte (todas que "chamaram" o token).
model TradeAttribution {
  id       String @id @default(cuid())
  tradeId  String
  trade    Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  sourceId String
  source   Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  // Rastreabilidade: qual compra da fonte casou e a defasagem (compra do usuário − compra da fonte).
  leadTradeId  String
  leadWalletId String
  lagSeconds   Int

  createdAt DateTime @default(now())

  @@unique([tradeId, sourceId])
  @@index([sourceId])
  @@index([tradeId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Posição por token (ledger materializado — acelera agregados sem rescan total)
// ─────────────────────────────────────────────────────────────────────────────

model TokenPosition {
  id       String @id @default(cuid())
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  mint   String
  symbol String?

  // Custo médio ponderado (WACC) e quantidade corrente ainda em carteira.
  qtyHeld      Decimal @default(0) @db.Decimal(38, 18)
  avgCostUsd   Decimal @default(0) @db.Decimal(38, 18) // custo médio por unidade
  realizedPnl  Decimal @default(0) @db.Decimal(38, 12) // PnL realizado acumulado (USD)
  feesUsd      Decimal @default(0) @db.Decimal(38, 12)
  buyCount     Int     @default(0)
  sellCount    Int     @default(0)
  firstBuyAt   DateTime?
  lastTradeAt  DateTime?

  updatedAt DateTime @updatedAt

  @@unique([walletId, mint])
  @@index([walletId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Snapshot de métricas (cache de leitura — invalidado a cada nova sync)
// ─────────────────────────────────────────────────────────────────────────────

enum MetricScope {
  WALLET // métricas de uma carteira específica
  PORTFOLIO // agregado de todas as carteiras do usuário
}

enum MetricPeriod {
  D30
  D90
  M12
}

model MetricSnapshot {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId String? // null quando scope = PORTFOLIO
  wallet   Wallet? @relation(fields: [walletId], references: [id], onDelete: Cascade)

  scope  MetricScope
  period MetricPeriod

  // Resultado calculado (PnL total, nº trades, buckets por hora/dia, hold times,
  // trades-após-perda, precisão/confiança, etc.). JSON versionado pelo tradesHash.
  data       Json
  tradesHash String // hash das entradas — se mudou, o snapshot é recomputado
  computedAt DateTime @default(now())

  @@unique([userId, walletId, scope, period])
  @@index([userId])
}

// Cache de candles OHLC por token (Bloco 2 — pico pós-entrada / benchmark).
// Evita refazer chamadas ao provider (custo/rate-limit). Preços como Decimal.
model TokenCandle {
  id        String    @id @default(cuid())
  chainType ChainType
  chain     Chain
  mint      String
  timeframe String // '1h' | '1d'
  openTime  DateTime // início do bucket (UTC)

  open  Decimal @db.Decimal(38, 18)
  high  Decimal @db.Decimal(38, 18)
  low   Decimal @db.Decimal(38, 18)
  close Decimal @db.Decimal(38, 18)

  createdAt DateTime @default(now())

  @@unique([chain, mint, timeframe, openTime])
  @@index([chain, mint, timeframe, openTime])
}

// Cobertura de candles já BUSCADOS por (chain, mint, timeframe). Registra a janela
// [fromTime, toTime] que já consultamos no provider — MESMO quando ele devolveu 0
// candles (token morto/sem OHLCV). Serve de "negative cache": se a janela pedida já
// está coberta, servimos do banco (possivelmente vazio) SEM tocar a API. Candles
// históricos são imutáveis → uma janela passada nunca precisa ser refeita.
model TokenCandleCoverage {
  chain     Chain
  mint      String
  timeframe String // '1h' | '1d'
  fromTime  DateTime // início da janela já coberta (UTC)
  toTime    DateTime // fim da janela já coberta (UTC)
  fetchedAt DateTime @default(now())

  @@id([chain, mint, timeframe])
}

// Preço/liquidez ATUAL de um token, PERSISTIDO (não só cache). Uma linha por
// (chain, mint) — a última leitura do provider (Jupiter/DexScreener). `fetchedAt`
// é o critério de frescor: leituras recentes são reusadas sem tocar a API.
// `priceUsd` null = sem mercado/liquidez (rugado) — também persistido p/ não
// re-consultar token morto a cada request.
model TokenPrice {
  chain        Chain
  mint         String
  priceUsd     Decimal? @db.Decimal(38, 18)
  liquidityUsd Decimal? @db.Decimal(38, 2)
  fetchedAt    DateTime @default(now())

  @@id([chain, mint])
  @@index([fetchedAt])
}

// Preço do SOL (USD) por DIA (fechamento), persistido. O fechamento diário é
// imutável → uma vez salvo, nunca refaz chamada (CoinGecko). Base do USD dos
// swaps SOL-quoted e de conversões.
model SolDayPrice {
  day       String   @id // YYYY-MM-DD (UTC)
  priceUsd  Decimal  @db.Decimal(38, 18)
  fetchedAt DateTime @default(now())
}

// ─────────────────────────── Discord Feed (bot) ───────────────────────────

// Regra de monitoramento de um canal do Discord. Gerenciada pelo admin (CRUD).
// Ao dar match do `pattern` numa mensagem do canal `channelId`, a captura é
// persistida (CapturedMessage) e empurrada para o Telegram (`telegramChatId`).
model DiscordMonitor {
  id   String  @id @default(cuid())
  name String? // rótulo opcional para o admin identificar a regra

  // Alvo: um CANAL específico (channelId) OU um SERVIDOR inteiro (guildId, sem
  // channelId → observa todos os canais do servidor). Ao menos um dos dois.
  channelId String? // ID do canal do Discord
  guildId   String? // ID do servidor (guild) — observa o servidor todo se sem channelId
  // Padrão de match: regex "/corpo/flags" OU substring literal (case-insensitive).
  // VAZIO/null = espelha TODAS as mensagens (inclusive de bots).
  pattern        String?
  telegramChatId String // destino do push no Telegram (ex.: -100...)

  // Espera ~1.5s e captura a RESPOSTA do bot (Rick etc.) com dados ricos, em vez
  // da mensagem crua do usuário. Desligável por regra.
  waitForBotReply Boolean @default(true)
  isActive        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  captures CapturedMessage[]

  @@index([channelId])
  @@index([guildId])
  @@index([isActive])
}

// Mensagem capturada de um canal monitorado (feed cru). Global (não é por usuário)
// — o acesso é gated por JWT. `embed`/`links` preservam o conteúdo rico para o site.
model CapturedMessage {
  id String @id @default(cuid())

  monitorId String?
  monitor   DiscordMonitor? @relation(fields: [monitorId], references: [id], onDelete: SetNull)

  guildName        String?
  channelId        String
  channelName      String?
  authorTag        String?
  authorId         String? // ID do autor no Discord (snowflake) — identidade estável p/ perfil/favoritos
  matchedPattern   String?
  discordMessageId String?

  text  String  @db.Text // texto extraído (content + embeds)
  embed Json? // embeds crus (para render rico no site)
  links String[] // URLs extraídas

  sentToTelegram Boolean @default(false)
  telegramError  String?

  createdAt DateTime @default(now())

  calls MessageCall[]

  @@index([channelId])
  @@index([monitorId])
  @@index([createdAt])
  // "Mensagens por autor" (perfil / feed de favoritos) — paginação por recência.
  // authorTag é a identidade usada (presente em 100% das capturas; o snowflake
  // authorId só passou a ser gravado depois e cobre parte do histórico).
  @@index([authorId, createdAt])
  @@index([authorTag, createdAt])
}

// "Call" derivada de uma mensagem capturada: um token (CA/mint) e/ou ticker citado
// num grupo, num instante. Tabela derivada (recomputável) e INDEXADA para o
// cruzamento eficiente trade × call (atribuição de fonte por Discord). Uma mensagem
// pode gerar várias calls (vários CAs/tickers). `guildName` = o servidor (a "fonte").
model MessageCall {
  id                String          @id @default(cuid())
  capturedMessageId String
  capturedMessage   CapturedMessage @relation(fields: [capturedMessageId], references: [id], onDelete: Cascade)

  chainType ChainType? // EVM | SOLANA (inferido do CA/link); null quando só ticker
  mint      String? // CA/mint normalizado (lowercase no EVM); null quando só ticker
  ticker    String? // símbolo em MAIÚSCULO sem '$'; null quando só CA

  guildName String? // servidor de origem (a fonte)
  channelId String
  calledAt  DateTime // = createdAt da mensagem (instante da call)

  @@index([mint, calledAt])
  @@index([ticker, calledAt])
  @@index([capturedMessageId])
}

// Usuário do Discord em BLACKLIST: mensagens dele NÃO são encaminhadas ao Telegram
// (global, vale para todas as regras). Casa por `discordUserId` (snowflake, exato)
// e/ou `username` (substring case-insensitive no username/tag). Ao menos um setado.
model BlacklistedUser {
  id            String  @id @default(cuid())
  discordUserId String? // ID do usuário no Discord (snowflake) — match exato
  username      String? // username/tag (ou parte) — match case-insensitive
  reason        String?
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// Autor do Discord "seguido" (favoritado) por um usuário da plataforma. Escopo por
// conta. A CHAVE de follow (`authorId`) guarda o `authorTag` do autor — identidade
// presente em 100% das capturas (o snowflake só cobre parte do histórico). Casa
// com `CapturedMessage.authorTag`. Idempotente por (userId, authorId).
model FavoriteAuthor {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  authorId  String // chave de follow = authorTag do autor (match exato)
  authorTag String? // exibição (redundante com a chave; mantido por clareza)

  // Personalização por conta (modal "Personalizar usuário").
  nickname String? // apelido dado pelo usuário (sobrepõe o nome exibido)
  color    String? // chave de cor do avatar (allowlist), null = cor por hash

  // Foto do avatar re-hospedada (bytes NOSSOS, webp), servida por endpoint público
  // pela chave `id` (cuid, não enumerável) — mesmo padrão do avatar de usuário.
  photoData      Bytes?
  photoMime      String?
  photoUpdatedAt DateTime? // cache-busting da URL da foto

  createdAt DateTime @default(now())

  @@unique([userId, authorId])
  @@index([userId])
}
